# WhatsApp works without environment variables.
# Configure these on Vercel for booking and Contact Us email delivery.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=Cappadocia Airport Shuttle <bookings@cappadociaairportshuttle.com>
BOOKING_EMAIL_TO=cappadociaairportshuttle@gmail.com
# Optional. If omitted, Contact Us uses BOOKING_EMAIL_TO.
CONTACT_EMAIL_TO=cappadociaairportshuttle@gmail.com
